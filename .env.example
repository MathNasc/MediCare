# ═══════════════════════════════════════════
#  MediCare — Environment Variables
#  Copy this file to .env.local and fill in
# ═══════════════════════════════════════════

# ── Supabase ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Web Push (VAPID) ──────────────────────
# Gerar com: npx web-push generate-vapid-keys
# A chave PRIVADA nunca vai no frontend — ela é um secret da Edge Function
# (supabase secrets set VAPID_PRIVATE_KEY=...), não do Next.js.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua_chave_publica_vapid_aqui

# ── App ───────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=MediCare

# ── Firebase (legado — não é mais usado para notificações) ──
# As variáveis NEXT_PUBLIC_FIREBASE_* podem ser removidas do Vercel após a
# migração para Web Push ser validada em produção. src/lib/firebase.js ficou
# órfão (sem imports) e pode ser deletado no mesmo momento.
